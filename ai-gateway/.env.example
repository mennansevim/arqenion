# Bu dosyayı .env adıyla kopyalayın. .env repoya GİTMEZ (.gitignore).
# Anahtar boşsa servis yine çalışır: her cevap hazır klinik metinden gelir (source = "table").
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=          # yalnızca Azure OpenAI ya da bir vekil sunucu kullanılacaksa
AI_TIMEOUT_SEC=6
# PROCEDURE_MODEL_VERSION=2.4
