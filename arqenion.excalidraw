      "isDeleted": false,
      "boundElements": [],
      "updated": 1788961607880,
      "link": null,
      "locked": false,
      "text": "Spanç sayımı yapılır.\nKompres sayımı yapılır.\nAlet sayımı yapılır.\nİğne sayımı yapılır.\nSayım doğrulanır.\n",
