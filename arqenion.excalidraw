    {
      "id": "DPE0hUBfd_CPAvULIMfBi",
      "type": "text",
      "x": 84380.89506581312,
      "y": -8801.970631671453,
      "width": 1005.983642578125,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
