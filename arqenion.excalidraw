    {
      "id": "8aNsb99hGUk9zlwwYIGOS",
      "type": "text",
      "x": 2476.008989623231,
      "y": -8524.360241375292,
      "width": 384.45953369140625,
      "height": 250,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1M",
