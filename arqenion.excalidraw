    {
      "id": "0Rw70DQieb-9z282u6eN7",
      "type": "text",
      "x": 127992.08728056707,
      "y": -9231.743544102417,
      "width": 2067.1552734375,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
