    {
      "id": "HvG6SQfEevq3Rj9RDIUn8",
      "type": "text",
      "x": 203722.09993083682,
      "y": -9372.556842087053,
      "width": 530.4957885742188,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
