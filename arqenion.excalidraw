    },
    {
      "id": "oloHDAlwPsxiqCgXv5hZv",
      "type": "text",
      "x": 144790.18251866224,
      "y": -6469.3625917214595,
      "width": 2245.1337890625,
      "height": 7200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAk",
