    {
      "id": "wHJjXyHhNoXUlQfuQWnun",
      "type": "text",
      "x": 15744.665014792416,
      "y": -8267.789779245959,
      "width": 481.37575364240183,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2u",
      "roundness": null,
      "seed": 130120103,
      "version": 91,
      "versionNonce": 519617161,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788956863472,
      "link": null,
      "locked": false,
      "text": "MAYO MASASI DÜZENİ\n        • Mayo masasındaki aletler ameliyat akışına\ngöre sağdan sola doğru dizilir\n        • En sağ alt köşe tarafa bistüri konumlanır.\n        • Bistürinin soluna pensetler konumlanır\n        • Pensetlerin soluna klempler/pean ler\nkonumlanır\n        • Klemp ve peanların üstüne ekartörler\nkonumlanır.\n        • Ekartörlerin sağına Steril tas, sütur iplikleri,\ndelici kesici alet mıknatısı veya tası\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MAYO MASASI DÜZENİ\n        • Mayo masasındaki aletler ameliyat akışına göre sağdan sola doğru dizilir\n        • En sağ alt köşe tarafa bistüri konumlanır.\n        • Bistürinin soluna pensetler konumlanır\n        • Pensetlerin soluna klempler/pean ler konumlanır\n        • Klemp ve peanların üstüne ekartörler konumlanır.\n        • Ekartörlerin sağına Steril tas, sütur iplikleri, delici kesici alet mıknatısı veya tası\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
