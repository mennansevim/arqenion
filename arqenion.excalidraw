    {
      "id": "cFYxBwBPVm24rcGyoTK3Z",
      "type": "text",
      "x": 4322.1830244477605,
      "y": -9378.110780894382,
      "width": 359.81951904296875,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
