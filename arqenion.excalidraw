    {
      "id": "AoIfBd7_AZqrN8oHKhfeL",
      "type": "text",
      "x": 9274.829289331905,
      "y": -8399.909236140042,
      "width": 553.8583984375,
      "height": 950,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b23",
