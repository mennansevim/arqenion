    {
      "id": "oGZY6MJCsbUTjisYUDpJX",
      "type": "text",
      "x": 238613.08405782026,
      "y": -9392.251286531493,
      "width": 1992.9232177734375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
