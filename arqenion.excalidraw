    {
      "id": "MJMlCNa_-CXTOa1lEzbfd",
      "type": "text",
      "x": -409.5000000000018,
      "y": -8261.214646464645,
      "width": 383.39971923828125,
      "height": 550,
      "angle": 0,
      "strokeColor": "#1e1e1e",
